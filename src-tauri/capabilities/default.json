{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认权限：主窗口可用核心 API",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-default-window-icon",
    "core:window:allow-destroy",
    "dialog:default",
    "process:default",
    "updater:default"
  ]
}
